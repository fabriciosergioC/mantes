# MongoDB Atlas
# Obtenha em: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/mantes?retryWrites=true&w=majority

# JWT Secret (use um valor aleatório em produção)
JWT_SECRET=secreto

# Porta do servidor
PORT=8080

# CORS (origem permitida - use * em produção ou domínios específicos)
CORS_ORIGIN=*
